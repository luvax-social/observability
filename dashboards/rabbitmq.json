{
  "uid": "rabbitmq",
  "title": "RabbitMQ",
  "tags": ["luvax"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ready messages by queue",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (queue) (rabbitmq_detailed_queue_messages_ready)", "legendFormat": "{{queue}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Unacked messages by queue",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (queue) (rabbitmq_detailed_queue_messages_unacked)", "legendFormat": "{{queue}}" }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "DLQ depth (red above 0)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "format": "table", "instant": true, "expr": "rabbitmq_detailed_queue_messages{queue=~\".+\\\\.dlq\"}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Consumers by queue",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rabbitmq_detailed_queue_consumers", "legendFormat": "{{queue}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Publish and deliver rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(rabbitmq_global_messages_received_total[$__rate_interval])", "legendFormat": "received" },
        { "refId": "B", "expr": "rate(rabbitmq_global_messages_delivered_total[$__rate_interval])", "legendFormat": "delivered" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Connections and channels",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rabbitmq_connections", "legendFormat": "connections" },
        { "refId": "B", "expr": "rabbitmq_channels", "legendFormat": "channels" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Node memory",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rabbitmq_process_resident_memory_bytes", "legendFormat": "resident memory" }
      ]
    }
  ]
}
