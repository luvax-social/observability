{
  "uid": "host-containers",
  "title": "Host & Containers",
  "tags": ["luvax"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Host CPU busy",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))", "legendFormat": "CPU busy" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Host memory available",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes", "legendFormat": "available" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Root disk used",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}",
          "legendFormat": "disk used"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Load average",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "node_load1", "legendFormat": "load1" },
        { "refId": "B", "expr": "node_load5", "legendFormat": "load5" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU by container",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_coolify_resourceName, name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{container_label_coolify_resourceName}} {{name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory by container",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "container_memory_working_set_bytes{name!=\"\"}", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Container restarts in range",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "changes(container_start_time_seconds{name!=\"\"}[$__range])", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Collector throughput and failures",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(otelcol_exporter_sent_log_records_total[$__rate_interval])", "legendFormat": "logs sent/s" },
        { "refId": "B", "expr": "rate(otelcol_exporter_sent_spans_total[$__rate_interval])", "legendFormat": "spans sent/s" },
        { "refId": "C", "expr": "rate(otelcol_exporter_send_failed_log_records_total[$__rate_interval])", "legendFormat": "logs failed/s" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "ClickHouse memory",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "ClickHouseMetrics_MemoryTracking", "legendFormat": "memory tracking" }]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Prometheus TSDB head series",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "prometheus_tsdb_head_series", "legendFormat": "head series" }]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Prometheus TSDB storage size",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "prometheus_tsdb_storage_blocks_bytes", "legendFormat": "storage blocks" }]
    },
    {
      "id": 12,
      "type": "state-timeline",
      "title": "Scrape targets up",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "1": { "text": "up", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "down", "color": "red" } } }
          ]
        },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "up", "legendFormat": "{{job}} {{instance}}" }]
    }
  ]
}
