{
  "uid": "logs-explorer",
  "title": "Logs Explorer",
  "tags": ["luvax"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "label": "Service",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "query": "SELECT DISTINCT ServiceName FROM otel.otel_logs WHERE Timestamp > now() - INTERVAL 1 DAY ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      },
      {
        "name": "level",
        "type": "custom",
        "label": "Level",
        "query": "All,TRACE,DEBUG,INFO,WARN,ERROR",
        "current": { "text": "All", "value": "All" }
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "Search",
        "current": { "text": "", "value": "" }
      },
      {
        "name": "traceId",
        "type": "textbox",
        "label": "Trace ID",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by service",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, ServiceName, count() FROM otel.otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName IN (${service:singlequote}) GROUP BY time, ServiceName ORDER BY time"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Logs",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "format": 3,
          "rawSql": "SELECT Timestamp AS timestamp, Body AS body, SeverityText AS level, TraceId AS traceID, SpanId AS spanID, ServiceName, ResourceAttributes['container.name'] AS container FROM otel.otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName IN (${service:singlequote}) AND ('${level}' = 'All' OR SeverityText = '${level}') AND ('${search}' = '' OR positionCaseInsensitive(Body, '${search}') > 0) AND ('${traceId}' = '' OR TraceId = '${traceId}') ORDER BY Timestamp DESC LIMIT 1000"
        }
      ]
    }
  ]
}
