{
  "uid": "outbox-inbox",
  "title": "Outbox & Inbox",
  "tags": ["luvax"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Outbox rows by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "luvax_outbox_events", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Oldest pending age",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "luvax_outbox_oldest_pending_age_seconds", "legendFormat": "oldest pending" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Outbox DEAD rows",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "instant": true, "expr": "luvax_outbox_events{status=\"DEAD\"}", "legendFormat": "DEAD" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Publish latency p95 by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(luvax_outbox_publish_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Publish lag p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(luvax_outbox_publish_lag_seconds_bucket[$__rate_interval])))",
          "legendFormat": "publish lag p95"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Publish outcomes rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(luvax_outbox_publish_seconds_count[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Inbox outcomes by consumer",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumer, outcome) (rate(luvax_inbox_messages_total[$__rate_interval]))",
          "legendFormat": "{{consumer}} {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Dead-lettered by queue",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (increase(luvax_messaging_dead_lettered_total[$__range]))",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Retention deletes",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (table) (increase(luvax_retention_deleted_rows_total[$__range]))",
          "legendFormat": "{{table}}"
        }
      ]
    }
  ]
}
