# Copy to observability/.env for the local profile.
# In production these are set as Coolify environment variables on the luvax-observability
# resource (runbook R5), never committed as a file.

# ClickHouse: the collector's writer and Grafana's read-only reader.
CLICKHOUSE_OTEL_PASSWORD=change-me
CLICKHOUSE_GRAFANA_PASSWORD=change-me

# Grafana.
GF_SECURITY_ADMIN_PASSWORD=change-me
# Discord webhook URL for the alerting contact point; leave blank locally to receive no alerts.
GF_DISCORD_WEBHOOK_URL=

# PostgreSQL statistics datasource and the postgres-exporter, both authenticating as the
# luvax_monitor role (pg_monitor only, created by docker/postgres/init/02-create-monitoring-role.sh
# locally and by runbook R3 in production).
POSTGRES_DB=app
POSTGRES_MONITOR_PASSWORD=change-me

# Redis exporter.
REDIS_PASSWORD=change-me

# Production only: which container name is the backend, so its own container logs (already sent
# over OTLP) are excluded from the container-log pipeline, and the stable production container
# names the collector labels into human-readable service names. Defaults match the plan's
# assumptions where runbook step R0 had no production host to confirm them against.
BACKEND_COOLIFY_RESOURCE_NAME=luvax-prod
LOG_CONTAINER_POSTGRES=
LOG_CONTAINER_REDIS=
LOG_CONTAINER_RABBITMQ=
LOG_CONTAINER_ELASTICSEARCH=
LOG_CONTAINER_GORSE=

# Production only: the PostgreSQL statistics datasource target.
PG_STATS_HOST=
PG_STATS_DATABASE=

# Production only: the Elasticsearch exporter's credentials and scheme (http or https).
# ES_URI_SCHEME is UNVERIFIED pending runbook R0; the elasticsearch-exporter command appends
# --es.ssl-skip-verify only if R0 finds a self-signed certificate.
ES_URI_SCHEME=http
ES_MONITOR_PASSWORD=change-me
